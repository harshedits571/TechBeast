rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ==========================================
    // HELPER FUNCTIONS
    // ==========================================
    
    // Check if user is the Root Admin (harshks12345@gmail.com)
    function isRootAdmin() {
      return request.auth != null && request.auth.token.email == 'harshks12345@gmail.com';
    }

    // Check if user is an Admin (Role based)
    function isAdmin() {
      return isRootAdmin() || 
        (request.auth != null && (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true
        ));
    }

    // Check if user is a Sub-Admin
    function isSubAdmin() {
      return request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'sub-admin';
    }
    
    // Check if user is an Approved Creator
    function isApprovedCreator() {
      return request.auth != null && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'creator' && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isCreatorApproved == true;
    }

    // Check if the current user owns the target UID
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // ==========================================
    // COLLECTIONS
    // ==========================================

    // 1. Users Collection
    match /users/{uid} {
      // Users can read their own data, Admins can read all data, and anyone can read Creator profiles
      allow read: if isOwner(uid) || 
                     isAdmin() || 
                     isSubAdmin() ||
                     resource.data.role == 'creator';
      
      // Users can create their own profile, but cannot inject admin/creator roles
      allow create: if isOwner(uid) && 
                    (!request.resource.data.keys().hasAny(['role', 'isAdmin', 'isCreatorApproved', 'isPaid', 'isBanned'])) || 
                    isAdmin();

      // Users can update their own profile, but CANNOT modify protected security fields
      allow update: if (isOwner(uid) && 
                        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'isAdmin', 'allowedSections', 'isCreatorApproved', 'isPaid', 'isBanned']))) || 
                        isAdmin();
                        
      allow delete: if isAdmin();
    }

    // 1a. Customers Collection
    match /customers/{email} {
      allow read, write: if request.auth != null && request.auth.token.email == email;
      allow read, write: if isAdmin() || isSubAdmin();
    }

    // 2. Products Collection (All Marketplace Assets)
    match /products/{productId} {
      // Anyone can read products (Public Storefront)
      allow read: if true; 

      // Create: Admins, Sub-Admins, or Approved Creators (Creators must set status to pending and use their own UID)
      allow create: if isAdmin() || 
                    isSubAdmin() ||
                    (isApprovedCreator() && request.resource.data.creatorId == request.auth.uid && request.resource.data.status == 'pending');

      // Update: Admins, Sub-Admins, or Approved Creators (Creators can only edit their own products and must stay pending if edited)
      allow update: if isAdmin() ||
                    isSubAdmin() ||
                    (isApprovedCreator() && resource.data.creatorId == request.auth.uid && request.resource.data.creatorId == request.auth.uid);

      // Delete: Admins, Sub-Admins, or the Creator who made it
      allow delete: if isAdmin() || isSubAdmin() || 
                    (isApprovedCreator() && resource.data.creatorId == request.auth.uid);
    }
    
    // 3. Settings & Config (Admin Panel)
    match /settings/{docId} {
      // Global settings are public so the frontend can load them
      allow read: if true; 
      // Only Admins can modify settings
      allow write: if isAdmin();
    }

    // 4. Transactions Ledger
    match /transactions/{transactionId} {
      // Admins read all, Users read their own purchases, Creators read their own sales
      allow read: if isAdmin() || 
                     isSubAdmin() ||
                     (request.auth != null && resource.data.uid == request.auth.uid) ||
                     (request.auth != null && resource.data.vendorId == request.auth.uid);
      
      // Anyone logged in can create a transaction record for themselves
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      
      allow update, delete: if isAdmin();
    }
    
    // 5. Download Logs Ledger
    match /downloadLogs/{logId} {
      // Admins read all, Users read their own
      allow read: if isAdmin() || isSubAdmin() || (request.auth != null && resource.data.uid == request.auth.uid) || (request.auth != null && resource.data.ownerUid == request.auth.uid);
      // Anyone logged in can create a download log for themselves
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      
      allow update, delete: if isAdmin();
    }
    
    // 6. Ratings & Reviews
    match /ratings/{ratingId} {
      allow read: if true;
      allow create, update: if request.auth != null; // Must be logged in to rate
      allow delete: if isAdmin();
    }
    
    // 7. Ratings Summary / Product Stats
    // These are aggregated stats often updated automatically from the client or functions
    match /ratingsSummary/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    match /product_stats/{productId} {
      allow read: if true;
      allow write: if request.auth != null; 
    }

    // 8. Feedback / Broken Link Reports
    match /brokenLinkReports/{reportId} {
      allow read: if isAdmin() || isSubAdmin();
      allow create: if request.auth != null;
      allow update, delete: if isAdmin();
    }

    // 9. Audit Logs
    match /auditLogs/{logId} {
      allow read: if isAdmin() || isSubAdmin();
      allow create: if request.auth != null; // Logged in users/creators/admins can write logs
      allow update, delete: if isAdmin();
    }

    // 10. Banners
    match /banners/{bannerId} {
      allow read: if true; // Publicly readable
      allow write: if isAdmin() || isSubAdmin();
    }

    // 11. User Messages (Contact Form)
    match /userMessages/{messageId} {
      allow read: if isAdmin() || isSubAdmin();
      allow create: if true; // Anyone can send a contact message
      allow update, delete: if isAdmin() || isSubAdmin();
    }
    // 12. Product Reviews
    match /productReviews/{reviewId} {
      allow read: if true;
      allow create, update: if request.auth != null;
      allow delete: if isAdmin();
    }
    
    // 13. Storage Audits
    match /storageAudits/{auditId} {
      allow read: if isAdmin() || isSubAdmin() || (request.auth != null && resource.data.uid == request.auth.uid);
      allow create: if request.auth != null;
      allow update, delete: if isAdmin();
    }

    // 14. Custom PC Quotation Requests
    match /custom_pc_requests/{document=**} {
      allow read, write: if true;
    }

    // 15. Orders
    match /orders/{document=**} {
      allow read: if isAdmin() || isSubAdmin() || (request.auth != null && request.auth.token.email == resource.data.customerEmail);
      allow create: if true;
      allow update, delete: if isAdmin() || isSubAdmin();
    }

    // 16. Repairs
    match /repairs/{document=**} {
      allow read: if isAdmin() || isSubAdmin() || (request.auth != null && request.auth.uid == resource.data.userId);
      allow create: if true;
      allow update, delete: if isAdmin() || isSubAdmin();
    }

    // 17. Inventory
    match /inventory/{document=**} {
      allow read, write: if isAdmin() || isSubAdmin();
    }
  }
}
