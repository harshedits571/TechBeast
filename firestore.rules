rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Allow read/write for products
    match /products/{document=**} {
      allow read, write: if true; 
    }
    
    // Allow read/write for repair tickets
    match /repairs/{document=**} {
      allow read, write: if true;
    }

    // Allow read/write for inventory items
    match /inventory/{document=**} {
      allow read, write: if true;
    }

    // Allow read/write for settings (like inventory categories)
    match /settings/{document=**} {
      allow read, write: if true;
    }

    // Allow read/write for customers
    match /customers/{document=**} {
      allow read, write: if true;
    }

    // Allow read/write for orders
    match /orders/{document=**} {
      allow read, write: if true;
    }
  }
}
