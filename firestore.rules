rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ==========================================
    // HELPER FUNCTIONS
    // ==========================================
    
    // Check if user is the Root Admin (harshks12345@gmail.com)
    function isRootAdmin() {
      return request.auth != null && request.auth.token.email == 'harshks12345@gmail.com';
    }

    // Check if user is an Admin (Role based or Root)
    function isAdmin() {
      return isRootAdmin() || 
        (request.auth != null && (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true
        ));
    }

    // Check if user is a Sub-Admin
    function isSubAdmin() {
      return request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'sub-admin';
    }
    
    // Check if user is an Approved Creator
    function isApprovedCreator() {
      return request.auth != null && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'creator' && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isCreatorApproved == true;
    }

    // Check if the current user owns the target UID
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // ==========================================
    // COLLECTIONS
    // ==========================================

    // 1. Users Collection
    match /users/{uid} {
      // Users can read their own data, Admins can read all data, and anyone can read Creator profiles
      allow read: if isOwner(uid) || 
                     isAdmin() || 
                     isSubAdmin() ||
                     resource.data.role == 'creator';
      
      // Users can create their own profile as customer, but cannot inject admin or privilege fields
      allow create: if (isOwner(uid) && 
                       (!request.resource.data.keys().hasAny(['isAdmin', 'allowedSections', 'isCreatorApproved', 'isPaid', 'isBanned']) &&
                        (!('role' in request.resource.data) || request.resource.data.role == 'customer'))) || 
                       isAdmin();

      // Users can update their own profile, but CANNOT modify protected security fields
      allow update: if (isOwner(uid) && 
                        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'isAdmin', 'allowedSections', 'isCreatorApproved', 'isPaid', 'isBanned']))) || 
                        isAdmin();
                        
      allow delete: if isAdmin();
    }

    // 1a. Customers Collection
    match /customers/{customerId} {
      allow read: if isAdmin() || isSubAdmin() || (request.auth != null && (request.auth.token.email == resource.data.email || request.auth.uid == customerId));
      allow create: if true; // Allowed so online checkout and repairs can register customer records
      allow update, delete: if isAdmin() || isSubAdmin() || (request.auth != null && (request.auth.token.email == resource.data.email || request.auth.uid == customerId));
    }

    // 2. Products Collection (All Marketplace Assets)
    match /products/{productId} {
      // Anyone can read products (Public Storefront)
      allow read: if true; 

      // Create: Admins, Sub-Admins, or Approved Creators
      allow create: if isAdmin() || 
                    isSubAdmin() ||
                    (isApprovedCreator() && request.resource.data.creatorId == request.auth.uid && request.resource.data.status == 'pending');

      // Update: Admins, Sub-Admins, or Approved Creators
      allow update: if isAdmin() ||
                    isSubAdmin() ||
                    (isApprovedCreator() && resource.data.creatorId == request.auth.uid && request.resource.data.creatorId == request.auth.uid);

      // Delete: Admins, Sub-Admins, or the Creator who made it
      allow delete: if isAdmin() || isSubAdmin() || 
                    (isApprovedCreator() && resource.data.creatorId == request.auth.uid);

      // Subcollection: Product Reviews
      match /reviews/{reviewId} {
        allow read: if true;
        allow create: if request.auth != null;
        allow update, delete: if isAdmin() || isSubAdmin();
      }
    }

    // 2a. Prebuilt PCs Collection
    match /prebuilts/{prebuiltId} {
      allow read: if true;
      allow write: if isAdmin() || isSubAdmin();
    }
    
    // 3. Settings & Config (Storefront Configuration)
    match /settings/{docId} {
      // Global settings (banners, contact, announcements) are public so the frontend can load them
      allow read: if true; 
      // Only Admins can modify settings
      allow write: if isAdmin() || isSubAdmin();
    }

    // 4. Transactions Ledger
    match /transactions/{transactionId} {
      allow read: if isAdmin() || 
                     isSubAdmin() ||
                     (request.auth != null && resource.data.uid == request.auth.uid) ||
                     (request.auth != null && resource.data.vendorId == request.auth.uid);
      
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isAdmin();
    }
    
    // 5. Download Logs Ledger
    match /downloadLogs/{logId} {
      allow read: if isAdmin() || isSubAdmin() || (request.auth != null && resource.data.uid == request.auth.uid) || (request.auth != null && resource.data.ownerUid == request.auth.uid);
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isAdmin();
    }
    
    // 6. Ratings & Reviews
    match /ratings/{ratingId} {
      allow read: if true;
      allow create, update: if request.auth != null;
      allow delete: if isAdmin() || isSubAdmin();
    }
    
    // 7. Ratings Summary / Product Stats
    match /ratingsSummary/{docId} {
      allow read: if true;
      allow write: if request.auth != null || isAdmin() || isSubAdmin();
    }
    
    match /product_stats/{productId} {
      allow read: if true;
      allow write: if request.auth != null || isAdmin() || isSubAdmin(); 
    }

    // 8. Feedback / Broken Link Reports
    match /brokenLinkReports/{reportId} {
      allow read: if isAdmin() || isSubAdmin();
      allow create: if request.auth != null;
      allow update, delete: if isAdmin() || isSubAdmin();
    }

    // 9. Audit Logs
    match /auditLogs/{logId} {
      allow read: if isAdmin() || isSubAdmin();
      allow create: if request.auth != null;
      allow update, delete: if isAdmin();
    }

    // 10. Banners
    match /banners/{bannerId} {
      allow read: if true;
      allow write: if isAdmin() || isSubAdmin();
    }

    // 11. User Messages (Contact Form)
    match /userMessages/{messageId} {
      allow read: if isAdmin() || isSubAdmin();
      allow create: if true;
      allow update, delete: if isAdmin() || isSubAdmin();
    }

    // 12. Product Reviews
    match /productReviews/{reviewId} {
      allow read: if true;
      allow create, update: if request.auth != null;
      allow delete: if isAdmin() || isSubAdmin();
    }
    
    // 13. Storage Audits
    match /storageAudits/{auditId} {
      allow read: if isAdmin() || isSubAdmin() || (request.auth != null && resource.data.uid == request.auth.uid);
      allow create: if request.auth != null;
      allow update, delete: if isAdmin();
    }

    // 14. Custom PC Quotation Requests (Direct link viewable by ID, list restricted to admin)
    match /custom_pc_requests/{requestId} {
      allow get: if true; // Public direct quote viewing by ID
      allow list: if isAdmin() || isSubAdmin(); // Bulk listing/searching restricted to admins
      allow create: if true;
      allow update, delete: if isAdmin() || isSubAdmin();
    }

    // 15. Orders
    match /orders/{document=**} {
      allow read: if isAdmin() || isSubAdmin() || (request.auth != null && request.auth.token.email == resource.data.customerEmail);
      allow create: if true;
      allow update, delete: if isAdmin() || isSubAdmin();
    }

    // 16. Repairs
    match /repairs/{document=**} {
      allow read: if isAdmin() || isSubAdmin() || (request.auth != null && request.auth.uid == resource.data.userId);
      allow create: if true;
      allow update, delete: if isAdmin() || isSubAdmin();
    }

    // 17. Inventory (Public read for Custom PC configurator & stock availability, admin write)
    match /inventory/{document=**} {
      allow read: if true;
      allow write: if isAdmin() || isSubAdmin();
    }
  }
}
